# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Datastores --------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://graphone:graphone@localhost:5432/graphone
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- LLM providers (fallback order: gemini -> groq -> deepseek) -------
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
LLM_PROVIDER_ORDER=gemini,groq,deepseek
LLM_TOKEN_BUDGET=12000

# --- GitHub enrichment ---------------------------------------------------
# Unauthenticated requests are limited to 60/hour; a token raises this to 5000/hour.
GITHUB_TOKEN=

# --- Google Sheets export (optional) ------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Crawling ------------------------------------------------------------
MAX_CONCURRENCY=20
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=30

# --- Freshness -------------------------------------------------------------
FRESHNESS_WINDOW_HOURS=24

# --- Raw storage -----------------------------------------------------------
RAW_STORAGE_BACKEND=local
RAW_STORAGE_LOCAL_PATH=./data/raw
S3_BUCKET=
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
